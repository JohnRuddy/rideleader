# Installed by deploy/deploy.sh as /opt/edge/sites/rideleader.caddy and imported by the shared Caddy.
# __DOMAIN__ is replaced from the DOMAIN value in .env. Caddy gets and renews the certificate once DNS points here.
__DOMAIN__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Pages may not be framed by other sites, except the public sponsor widget, which clubs put on their own websites.
	@notembed not path /embed/*
	header @notembed X-Frame-Options "SAMEORIGIN"
	reverse_proxy rideleader-web:8431
}
